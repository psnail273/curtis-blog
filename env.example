# Copy this file to .env.local and fill in the values
# cp env.example .env.local

# Database (Neon Serverless Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Admin Panel
ADMIN_PASSWORD=

# Google OAuth (for comments - https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=  # Generate with: openssl rand -base64 32
AUTH_TRUST_HOST=true  # Required for OAuth callbacks (especially in Docker/proxy setups)

# Twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
NEXT_PUBLIC_TWITCH_USERNAME=

# YouTube
YOUTUBE_API_KEY=
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=
NEXT_PUBLIC_YOUTUBE_HANDLE=
