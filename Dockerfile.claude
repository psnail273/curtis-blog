# Dockerfile.claude — Drop into any repo, run claude-start
FROM node:22-slim

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install essentials (git, ripgrep, etc. that Claude Code expects)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ripgrep \
    ca-certificates \
    bash \
    jq \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# Set up workspace directory and consistent HOME for auth persistence
RUN mkdir -p /workspaces /home/claude && chmod 777 /home/claude
ENV HOME=/home/claude

# Install Claude Code globally via npm (node image already has /usr/local/bin on PATH)
RUN npm install -g @anthropic-ai/claude-code

WORKDIR /workspaces

# Read API key from secret mount at runtime, then exec claude
ENTRYPOINT ["/bin/bash", "-c", "exec claude --dangerously-skip-permissions \"$@\"", "--"]